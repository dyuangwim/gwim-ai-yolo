from gpiozero import DigitalOutputDevice
import time

# 假设你的 DIR 在 22, STEP 在 27
dir_pin = DigitalOutputDevice(22)
step_pin = DigitalOutputDevice(27)

def move(steps, direction):
    dir_pin.value = direction
    for _ in range(steps):
        step_pin.on()
        time.sleep(0.0005)
        step_pin.off()
        time.sleep(0.0005)

print("Testing Forward...")
move(400, True)
time.sleep(1)
print("Testing Backward...")
move(400, False)
